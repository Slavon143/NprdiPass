# NordiPass first pilot on Oderland Standard. This is NOT a deployable secret file.
# Fill empty required fields privately in the production shared/.env.
# Never reuse staging APP_KEY, database, credentials, storage or cron locks.
APP_NAME=NordiPass
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nordipass.com
PASSPORT_PUBLIC_BASE_URL=https://nordipass.com
APP_TIMEZONE=UTC
APP_LOCALE=sv
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily_json
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
# Dedicated production database/user; do not use staging or root.
DB_DATABASE=codecraf_np_production
DB_USERNAME=codecraf_np_prod
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Shared Redis is evicting/nonpersistent: critical state stays in MySQL.
CACHE_STORE=database
CACHE_PREFIX=nordipass-production-cache-
QUEUE_CONNECTION=database
QUEUE_RETRY_AFTER=360
SESSION_DRIVER=database
SESSION_CONNECTION=null
SESSION_COOKIE=nordipass-production-session
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Configure an authenticated sender and test an actual invitation delivery.
MAIL_MAILER=smtp
INVITATION_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=marisha.oderland.com
MAIL_PORT=465
MAIL_USERNAME=hello@nordipass.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@nordipass.com
MAIL_FROM_NAME=NordiPass

FILESYSTEM_DISK=local
PASSPORT_ASSET_READONLY=true
TENANCY_SESSION_KEY=nordipass.current_company_id
API_ALLOWED_ORIGINS=https://nordipass.com
API_ALLOW_NON_EXPIRING_TOKENS=false

TRUSTED_HOSTS=^nordipass\.com$
# Fill only after inspecting the actual proxy chain; do not use *.
TRUSTED_PROXIES=
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
SECURITY_HSTS_PRELOAD=false
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false

HEALTH_ENABLED=true
HEALTH_DETAILS=false
HEALTH_REQUIRE_DATABASE=true
HEALTH_REQUIRE_CACHE=true
HEALTH_REQUIRE_QUEUE=true
HEALTH_REQUIRE_ASYNC_QUEUE=true
HEALTH_REQUIRE_SCHEDULER=true
HEALTH_SCHEDULER_MAX_AGE=180
HEALTH_REQUIRE_WORKER=true
HEALTH_WORKER_MAX_AGE=180

BACKUP_ENABLED=true
BACKUP_DISK=local
BACKUP_PATH=nordipass-production/backups
BACKUP_DATABASE_ENABLED=true
BACKUP_FILES_ENABLED=true
BACKUP_VERIFY_AFTER_CREATE=true
# Confirm native binaries on target before enabling scheduled backup.
BACKUP_DATABASE_BINARY=
RESTORE_DATABASE_BINARY=
BACKUP_MAX_AGE_HOURS=24
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3

# Initial pilot: catalogue imports/public passports; external integrations off.
FEATURE_PRODUCTION_IMPORTS=true
FEATURE_FORTNOX_INTEGRATION=false
FORTNOX_PROVIDER=http
FORTNOX_NONPRODUCTION_OAUTH_ENABLED=false
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FEATURE_BILLING=false
BILLING_COMMERCIAL_ENABLED=false
BILLING_PROVIDER=stripe
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
FEATURE_ANALYTICS=false
FEATURE_NOTIFICATIONS_CENTER=false
FEATURE_PLATFORM_OPERATIONS=false
VITE_APP_NAME=NordiPass
