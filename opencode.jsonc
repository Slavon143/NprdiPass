{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  "permission": {
    "bash": {
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "git clean -xdf*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git rebase *": "ask",
      "git commit *": "ask",
      "git push *": "ask"
    }
  }
}
